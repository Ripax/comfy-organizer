/* =========================================================
    MAIN WINDOW
   ========================================================= */

QMainWindow {
    background-color: #1e1e1e;
}

QWidget {
    background-color: #1e1e1e;
    color: #cccccc;
    font-family: "Segoe UI";
    font-size: 10pt;
}


/* =========================================================
    LABELS
   ========================================================= */

QLabel {
    color: #cccccc;
}

QLabel#queueTitle {
    color: #ffffff;
    font-size: 13px;
    font-weight: bold;
    padding: 4px;
}

QLabel#appTitle {
    color: #f8fafc;
    font-size: 20pt;
    font-weight: 700;
}

QLabel#appSubtitle {
    color: #94a3b8;
    font-size: 9pt;
}

QLabel#paneTitle {
    color: #8fa4bf;
    font-size: 9pt;
    font-weight: bold;
    padding: 2px 6px;
}

QLabel#queueCount {
    background-color: #26364a;
    color: #93c5fd;
    border-radius: 10px;
    padding: 4px 10px;
    font-size: 9pt;
    font-weight: bold;
}

QStatusBar {
    background-color: #171c26;
    color: #94a3b8;
    border-top: 1px solid #303a4b;
}


/* =========================================================
    LEFT TREE + RIGHT GRID
   ========================================================= */

QTreeView,
QListView {

    background-color: #252526;

    color: #cccccc;

    border: 1px solid #3e3e42;

    border-radius: 7px;

    selection-background-color: #094771;

    selection-color: #ffffff;

    outline: none;

    padding: 6px;
}


/* =========================================================
    TREE ITEMS
   ========================================================= */

QTreeView::item {

    padding: 5px;

    margin: 1px;

    border-radius: 4px;
}

QTreeView::item:hover {

    background-color: #2a2d2e;
}

QTreeView::item:selected {

    background-color: #094771;

    color: #ffffff;
}


/* =========================================================
    GRID ITEMS
   ========================================================= */

QListView::item {

    padding: 7px;

    margin: 5px;

    border-radius: 8px;
}

QListView::item:hover {

    background-color: #2a2d2e;
}

QListView::item:selected {

    background-color: #094771;

    color: #ffffff;

    border: 1px solid #1177bb;
}


/* =========================================================
    TABLE
   ========================================================= */

QTableWidget {

    background-color: #252526;

    color: #cccccc;

    border: 1px solid #3e3e42;

    border-radius: 7px;

    gridline-color: #3e3e42;

    selection-background-color: #094771;

    selection-color: #ffffff;

    alternate-background-color: #2a2a2b;

    outline: none;
}

QTableWidget::item {

    padding: 6px;
}

QTableWidget::item:hover {

    background-color: #2a2d2e;
}


/* =========================================================
   TABLE HEADER
   ========================================================= */

QHeaderView::section {

    background-color: #333333;

    color: #cccccc;

    padding: 7px;

    border: 1px solid #3e3e42;

    font-weight: bold;
}


/* =========================================================
    BUTTONS
   ========================================================= */

QPushButton {

    background-color: #0e639c;

    color: #ffffff;

    border: none;

    padding: 8px 20px;

    border-radius: 5px;

    font-weight: bold;

    min-height: 18px;
}

QPushButton:hover {

    background-color: #1177bb;
}

QPushButton:pressed {

    background-color: #094771;
}

QPushButton:disabled {
    background-color: #30343b;
    color: #777f8a;
}

/* Refresh */

QPushButton#refreshBtn {

    background-color: #3e3e42;
}

QPushButton#refreshBtn:hover {

    background-color: #4e4e52;
}

QPushButton#parentBtn {
    background-color: #34445a;
}

QPushButton#parentBtn:hover {
    background-color: #415671;
}


/* Clear */

QPushButton#clearBtn {

    background-color: #7a2d2d;
}

QPushButton#clearBtn:hover {

    background-color: #933636;
}


/* Commit */

QPushButton#commitBtn {

    background-color: #16825d;
}

QPushButton#commitBtn:hover {

    background-color: #1a9c70;
}

QPushButton#commitBtn:pressed {

    background-color: #106044;
}


/* =========================================================
    SPLITTER
   ========================================================= */

QSplitter::handle {

    background-color: #3e3e42;

    margin: 2px;
}

QSplitter::handle:hover {

    background-color: #007acc;
}

QSplitter::handle:horizontal {

    width: 4px;
}

QSplitter::handle:vertical {

    height: 4px;
}


/* =========================================================
    SCROLLBARS
   ========================================================= */

QScrollBar:vertical {

    border: none;

    background: #1e1e1e;

    width: 12px;

    margin: 2px;
}

QScrollBar::handle:vertical {

    background: #424242;

    min-height: 25px;

    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {

    background: #5a5a5a;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {

    height: 0px;
}


QScrollBar:horizontal {

    border: none;

    background: #1e1e1e;

    height: 12px;
}

QScrollBar::handle:horizontal {

    background: #424242;

    min-width: 25px;

    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {

    background: #5a5a5a;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {

    width: 0px;
}
